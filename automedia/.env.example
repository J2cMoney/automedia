# ============================================
# AutoMedia 配置模板 - 复制为 .env 填真实值
# ⚠️ 安全规范:.env 不提交,.env.example 提交,API key 只从这里读
# ============================================

# ---- DeepSeek(文本:文案/回评) ----
# POC 验证:文本强+便宜,看不了图
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 智谱 GLM 视觉(视频剪辑大脑) ----
# 智谱官方开放平台,OpenAI 兼容格式,能看抽帧做剪辑决策
GLM_API_KEY=your-zhipu-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4v-flash

# ---- Cookie 加密密钥(Phase 2 登录态加密) ----
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 绝不提交真实密钥;换了密钥旧 cookie 密文无法解密
COOKIE_ENCRYPT_KEY=replace-with-fernet-key-base64

# ---- Redis(RQ 任务队列) ----
# Docker 启动: docker run -d --name automedia-redis -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- SQLite 数据库 ----
# 相对路径基于 automedia/ 目录
DATABASE_URL=sqlite+aiosqlite:///./data/automedia.db

# ---- 应用 ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- 任务调度(FLOW-8) ----
# Playwright/Chrome 并发上限(单机内存约束,默认 3)
MAX_BROWSER_CONCURRENCY=3
# 渲染并发上限(CPU 密集,串行队列,默认 2)
MAX_RENDER_CONCURRENCY=2
# 发布风控:同账号同平台两次发布最小间隔(分钟)
PUBLISH_INTERVAL_MINUTES=30
