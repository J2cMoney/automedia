# ============================================
# AutoMedia .gitignore
# ⚠️ 配置安全:.env 不提交,key 只从环境变量读
# ============================================

# ---- 密钥与配置(绝不提交) ----
.env
.env.*
!.env.example

# ---- 数据库与数据 ----
*.db
*.db-journal
*.db-wal
*.db-shm
data/
*.sqlite
*.sqlite3

# ---- 产出物与中间文件 ----
output/
frames/
*.mp4
*.mp3
*.wav
!design-prototype/**
!poc/test_video.mp4

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# ---- pytest / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Node/前端(Phase 2+ 用) ----
node_modules/
frontend/dist/
frontend/.vite/
.vite/
# TS 增量编译产物
*.tsbuildinfo
# Remotion 渲染临时产物
remotion_project/public/

# ---- 日志 ----
*.log
logs/
